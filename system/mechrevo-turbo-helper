#!/usr/bin/python3 -I
"""Candidate client; root-only socket, no hardware access in this client."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from mechrevo_turbo_backend import client_request, doctor

parser = argparse.ArgumentParser(description="候选狂暴调度控制；输出始终为JSON")
sub = parser.add_subparsers(dest="command", required=True)
for name in ("doctor", "status", "release", "suspend", "resume"):
    sub.add_parser(name)
select = sub.add_parser("select")
select.add_argument("variant", choices=("quiet", "extreme"))
args = parser.parse_args()
try:
    result = {"ok": True, "result": doctor()} if args.command == "doctor" else client_request(vars(args))
    print(json.dumps(result, ensure_ascii=False))
    sys.exit(0 if result["ok"] else 1)
except Exception as error:
    print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False))
    sys.exit(1)
