#!/usr/bin/python3 -I
"""Exact-model firmware profiles and qualified CPU/fan tuning, with recovery journal."""
import fcntl
import errno
import json
import os
from pathlib import Path
import stat
import sys
import time
import subprocess
import tempfile

BASE = 0xFE410000
MODE = 0x751
MODES = {"office": 0xA0, "balanced": 0x20, "turbo": 0x30, "custom": 0x00}
FLAG_MASKS = {0x726: 0x80, 0x727: 0x40}
REGISTERS = (MODE, 0x490, 0x706, 0x726, 0x727, 0x728, 0x741, 0x743, 0x744, 0x745, 0x746,
             0x783, 0x784, 0x785, 0x786, 0x787, 0x7AB, 0x7C5, 0x7C6, 0x7CC, 0x7D2, 0x7E8)
GPU_UEFI = Path('/sys/firmware/efi/efivars/OemMagicVariable-9f33f85c-13ca-4fd1-9c4a-96217722c593')
LOGO_MASKS = {0x767: 0x80, 0x769: 0xff, 0x76a: 0xff, 0x76b: 0xff, 0x7ab: 0xe0, 0x7c5: 7}
LOGO_COLORS = [(255,255,255),(255,0,0),(0,255,0),(0,0,255),(255,255,0),(136,0,255),(0,255,255)]
TURBO_HELPER = Path('/usr/local/libexec/mechrevo-turbo-helper')
TURBO_JOURNAL = Path('/run/mechrevo-turbo.json')
TURBO_DEVICE = Path('/dev/mechrevo-turbo')


def turbo_fallback(error=None):
    if TURBO_JOURNAL.exists():
        raise RuntimeError('狂暴调度存在待恢复记录')
    result = {'available': False, 'active': False}
    if TURBO_DEVICE.exists():
        fd = os.open(TURBO_DEVICE, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            info = os.fstat(fd)
            if not stat.S_ISCHR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
                raise RuntimeError('狂暴调度设备权限异常')
            bridge = json.loads(os.pread(fd, 8192, 0))
            if (bridge.get('abi') != 1 or bridge.get('read_rc') != 0 or
                    type(bridge.get('active')) is not bool or type(bridge.get('recovery_needed')) is not bool):
                raise RuntimeError('无法确认内核调度恢复状态')
            result.update(bridge)
        finally:
            os.close(fd)
    if error: result['error'] = str(error)
    return result


def turbo_request(command, optional=False):
    """Call before taking profile_lock; the daemon uses that same lock."""
    if not TURBO_HELPER.exists():
        if optional:
            return turbo_fallback()
        raise RuntimeError('狂暴调度助手未安装，或存在待恢复记录')
    try:
        process = subprocess.run([str(TURBO_HELPER), *command], capture_output=True,
                                 text=True, timeout=4)
        data = json.loads(process.stdout)
        if process.returncode or data.get('ok') is not True:
            raise RuntimeError(data.get('error') or '狂暴调度服务不可用')
        result = data['result']; bridge = result.get('bridge', result)
        if type(bridge.get('active')) is not bool:
            raise RuntimeError('狂暴调度未返回有效状态')
        return {'available': True, **bridge, 'scheduler': result.get('scheduler')}
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.TimeoutExpired) as exc:
        if optional:
            return turbo_fallback(exc)
        raise RuntimeError('狂暴调度操作失败：'+str(exc)) from exc


def status_with_turbo(ec, turbo):
    result = status(ec)
    result['turbo'] = turbo
    result['turbo_variants_supported'] = turbo.get('available', False)
    if turbo.get('active') and not turbo.get('available'):
        result['switchable'] = False
        result['reason'] = '狂暴调度后台未就绪，等待内核归还控制后再切档'
        return result
    if turbo.get('recovery_needed') and not turbo.get('active'):
        result['switchable'] = False
        result['reason'] = ('固件温控状态无法确认，已停止软件切档；请正常重启电脑'
                            if turbo.get('policy_uncertain') else '狂暴调度恢复尚未完成，请先交还固件控制')
        return result
    # Managed turbo owns APPE/workload flags. Main-mode changes first release it.
    if (turbo.get('active') and turbo.get('standard_turbo') and result['mode']=='turbo'
            and not result['tuning_active'] and not result['tuning_recovery_pending']):
        result['switchable'] = True
        result['reason'] = ''
    return result


def check_machine():
    for name, expected in {
        "sys_vendor": "MECHREVO", "board_name": "YAOSHI Series-XxAF55xx",
        "bios_version": "N.1.33MRO91",
    }.items():
        if Path('/sys/class/dmi/id', name).read_text().strip() != expected:
            raise RuntimeError('机型或 BIOS 已变化，需要重新验证性能适配')
    if 'fe410000-fe410fff : INOU0000:00' not in Path('/proc/iomem').read_text():
        raise RuntimeError('固件 EC 内存资源与已验证地址不符')


class EC:
    def __init__(self, writable=False):
        self.fd = os.open('/dev/mem', (os.O_RDWR if writable else os.O_RDONLY) | os.O_CLOEXEC)

    def read(self, address):
        if address not in REGISTERS and address not in LOGO_MASKS and address != 0x78c and not 0xF00 <= address <= 0xF5F:
            raise ValueError('Unsupported register')
        data = os.pread(self.fd, 1, BASE + address)
        if len(data) != 1:
            raise OSError('EC 读取不完整')
        return data[0]

    def write_mode(self, value):
        if value not in (*MODES.values(), 0x10):
            raise ValueError('Unsupported mode value')
        if os.pwrite(self.fd, bytes([value]), BASE + MODE) != 1:
            raise OSError('EC 写入不完整')

    def write_flag(self, address, enabled):
        if address not in FLAG_MASKS or not isinstance(enabled, bool):
            raise ValueError('Unsupported flag')
        mask = FLAG_MASKS[address]
        value = (self.read(address) & ~mask) | (mask if enabled else 0)
        if os.pwrite(self.fd, bytes([value]), BASE + address) != 1:
            raise OSError('EC 标志写入不完整')

    def write_tuning(self, address, value):
        if address not in OWN_MASKS and not 0xF00 <= address <= 0xF5F:
            raise ValueError('Unsupported tuning register')
        if type(value) is not int or not 0 <= value <= 255:
            raise ValueError('Invalid byte')
        if os.pwrite(self.fd, bytes([value]), BASE + address) != 1:
            raise OSError('EC 写入不完整')

    def close(self):
        os.close(self.fd)

    def write_logo(self, address, value):
        if address not in LOGO_MASKS and address != 0x78c:
            raise ValueError('Unsupported logo register')
        mask = LOGO_MASKS.get(address, 0x10)
        if type(value) is not int or value & ~mask or value < 0:
            raise ValueError('Invalid logo bits')
        current = self.read(address)
        if os.pwrite(self.fd, bytes([(current & ~mask) | value]), BASE + address) != 1:
            raise OSError('Logo 写入不完整')


def logo_status(ec):
    raw = ec.read(0x7ab)
    if not raw & 1: raise RuntimeError('本机固件未报告 Logo 灯支持')
    level = raw >> 5
    if level > 4: raise RuntimeError('Logo 亮度状态不在官方范围内')
    rainbow = bool(ec.read(0x767) & 128)
    breathing = ec.read(0x7c5) & 7
    channels = [ec.read(a) for a in (0x769,0x76a,0x76b)]
    if any(c > 50 for c in channels): raise RuntimeError('Logo RGB 状态不在官方范围内')
    color = list(LOGO_COLORS[breathing-1]) if breathing else [(c*51+9)//10 for c in channels]
    return {'logo_enabled': bool(level), 'brightness': level*25,
            'mode': 'rainbow' if rainbow else 'breathing' if breathing else 'solid', 'color': color}


def validate_logo(config):
    if not isinstance(config,dict) or set(config) != {'mode','brightness','color'}:
        raise ValueError('Logo 设置字段不完整')
    mode, brightness, color = config['mode'], config['brightness'], config['color']
    if mode not in ('solid','breathing','rainbow') or type(brightness) is not int or brightness not in (0,25,50,75,100):
        raise ValueError('Logo 灯效或亮度不在官方范围内')
    if not isinstance(color,list) or len(color)!=3 or any(type(v) is not int or not 0<=v<=255 for v in color):
        raise ValueError('Logo RGB 必须为三个 0–255 整数')
    if mode=='breathing' and tuple(color) not in LOGO_COLORS:
        raise ValueError('Logo 呼吸仅支持白、红、绿、蓝、黄、紫、青')
    return dict(config)


def set_logo(ec, config, pause=time.sleep):
    config=validate_logo(config);logo_status(ec)
    before={a:ec.read(a) for a in LOGO_MASKS}
    target={};level=(config['brightness']//25)<<5
    # OEM CloseEffectEC only changes brightness; keep prior effect/color when off.
    if level:
        mode=config['mode'];target[0x767]=128 if mode=='rainbow' else 0
        target[0x7c5]=LOGO_COLORS.index(tuple(config['color']))+1 if mode=='breathing' else 0
        if mode=='solid':
            channels=[min(v*10//51,50) for v in config['color']]
            if not any(channels):level=0
            else:target.update(zip((0x769,0x76a,0x76b),channels))
    target[0x7ab]=level
    attempted=[]
    try:
        for a,v in target.items():
            attempted.append(a);ec.write_logo(a,v)
        ec.write_logo(0x78c,16);pause(.15)
        if any(ec.read(a)&LOGO_MASKS[a]!=v for a,v in target.items()):
            raise RuntimeError('Logo 设置回读不一致')
        return logo_status(ec)
    except BaseException as error:
        failures=[]
        for a in reversed(attempted):
            try:
                if ec.read(a)&LOGO_MASKS[a]==target[a]:ec.write_logo(a,before[a]&LOGO_MASKS[a])
            except Exception as exc:failures.append(str(exc))
        try:ec.write_logo(0x78c,16)
        except Exception as exc:failures.append(str(exc))
        if failures:raise RuntimeError(str(error)+'；Logo 恢复未完成：'+'；'.join(failures)) from error
        raise


def snapshot(ec):
    return {address: ec.read(address) for address in REGISTERS}


def standard_state(values):
    common = (values[0x706] == 0x40 and not values[0x741] & 1
              and not values[0x7C5] & 0x80 and not values[0x7C6] & 4
              and all(values[a] == 0 for a in (0x783, 0x784, 0x785, 0x786, 0x787)))
    regular = (values[MODE] in (0xA0, 0x00, 0x10, 0x20, 0x30)
               and not values[0x726] & 0x80 and not values[0x727] & 0x40)
    custom = (values[MODE] == 0 and values[0x726] & 0x80 and values[0x727] & 0x40)
    return bool(common and (regular or custom))


def mode_name(values):
    raw = values[MODE]
    if raw == 0 and values[0x726] & 0x80 and values[0x727] & 0x40:
        return 'custom'
    if raw in (0x10, 0x30):
        return 'turbo'
    if raw in (0x00, 0x20):
        return 'balanced'
    return 'office' if raw == 0xA0 else 'unknown'


def status(ec):
    values = snapshot(ec)
    state = read_state()
    managed = bool(state and state['phase'] == 'active' and matches(ec, state))
    standard = standard_state(values) and not state
    try:
        check_gpu_capability(ec)
        gpu_supported, gpu_reason = True, ''
    except Exception as error:
        gpu_supported, gpu_reason = False, str(error)
    return {
        'mode': mode_name(values),
        'switchable': standard or managed,
        'reason': '' if standard or managed else '检测到其他控制程序、未验证的风扇或功耗设置，暂停软件切档',
        'ec_mode': hex(values[MODE]),
        'custom_supported': True, 'custom_tuning_supported': True,
        'tuning_active': managed, 'tuning_recovery_pending': bool(state and not managed),
        'tuning': state['config'] if managed else None,
        'cpu_limits_w': [25, 75],
        'gpu_tuning_supported': gpu_supported, 'gpu_tuning_range': [65, 115], 'gpu_db_range': [5, 25],
        'gpu_tuning_reason': gpu_reason,
        'turbo_variants_supported': False,
        'turbo_variant': 'quiet' if values[0x728] & 1 else 'extreme',
    }


def set_mode(ec, name, pause=time.sleep):
    target = MODES[name]
    before = snapshot(ec)
    if not standard_state(before):
        raise RuntimeError('当前 EC 状态不属于已验证的基础档位，拒绝覆盖')
    if mode_name(before) == name:
        return status(ec)
    if snapshot(ec) != before:
        raise RuntimeError('硬件状态正在变化，请稍后重试')
    if name == 'custom':
        # OEM 0x060019b5: CustomerModeLightOn, MODE=0, custom flag.
        steps = [(0x727, 1), (MODE, target), (0x726, 1)]
    elif mode_name(before) == 'custom':
        steps = [(0x726, 0), (0x727, 0), (MODE, target)]
    else:
        steps = [(MODE, target)]
    attempted = []
    try:
        for address, value in steps:
            old = ec.read(address)
            mask = FLAG_MASKS.get(address, 0xFF)
            expected = value if address == MODE else ((old & ~mask) | (mask if value else 0))
            attempted.append((address, old, expected, mask))
            if address == MODE:
                ec.write_mode(value)
            else:
                ec.write_flag(address, bool(value))
        pause(0.25)
        result = status(ec)
        if result['mode'] != name or not standard_state(snapshot(ec)):
            raise RuntimeError('档位回读不一致，请检查机身模式键')
        return result
    except Exception as error:
        rollback_errors = []
        for address, old, expected, mask in reversed(attempted):
            try:
                current = ec.read(address)
                if current & mask != expected & mask:
                    continue  # A hardware key or another owner wins.
                if address == MODE:
                    ec.write_mode(old)
                else:
                    ec.write_flag(address, bool(old & mask))
            except Exception as rollback_error:
                rollback_errors.append(str(rollback_error))
        if rollback_errors:
            raise RuntimeError(str(error) + '；恢复未完成：' + '；'.join(rollback_errors)) from error
        raise


# This board's factory hysteresis table was read through the OEM F5D/F5E handshake.
CPU_UP = [48,52,56,60,64,68,72,76,80,85,255,255,255,255,255,255]
GPU_UP = [46,50,54,58,62,66,70,74,78,81,255,255,255,255,255,255]
CPU_DOWN = [0,46,50,54,58,62,66,70,74,78,82,255,255,255,255,255]
GPU_DOWN = [0,44,48,52,56,60,64,68,72,76,80,255,255,255,255,255]
MIN_DUTY = [40,40,40,40,50,55,60,70,80,90,100]
BASE_OWN_MASKS = {0x726:128, 0x727:64, MODE:255, 0x741:1,
                  0x783:255, 0x784:255, 0x7C5:128, 0x7C6:4}
GPU_OWN_MASKS = {0x743:7, 0x744:255, 0x745:255, 0x746:255}
OWN_MASKS = {**BASE_OWN_MASKS, **GPU_OWN_MASKS}
STATE = Path('/run/mechrevo-tuning.json')


def validate_config(config):
    required = {'pl1','pl2','cpu_fan','gpu_fan'}
    if not isinstance(config, dict) or set(config) not in (required, required | {'gpu_ctgp'}, required | {'gpu_ctgp','gpu_db'}):
        raise ValueError('自定义设置字段不完整')
    if 'gpu_ctgp' in config and (type(config['gpu_ctgp']) is not int or not 65 <= config['gpu_ctgp'] <= 115):
        raise ValueError('已验证 GPU cTGP 范围为65–115 W')
    if 'gpu_db'in config and (type(config['gpu_db'])is not int or config['gpu_db']!=0 and not 5<=config['gpu_db']<=25):
        raise ValueError('Dynamic Boost仅支持关闭或5–25 W，不接受自定义TPP')
    if any(type(config[k]) is not int for k in ('pl1','pl2')) or not (25 <= config['pl1'] == config['pl2'] <= 75):
        raise ValueError('已验证 CPU 范围为 25–75 W，持续与短时上限需保持一致')
    for name in ('cpu_fan','gpu_fan'):
        curve = config[name]
        if not isinstance(curve, list) or len(curve) != 11:
            raise ValueError('风扇曲线需要 11 个节点')
        if any(type(v) is not int or not MIN_DUTY[i] <= v <= 100 for i,v in enumerate(curve)):
            raise ValueError('风扇不能低于已验证的出厂冷却基线，高温节点必须为 100%')
        if curve != sorted(curve):
            raise ValueError('风扇转速必须随温度单调不减')
    return config


def parse_gpu_uefi(raw):
    if len(raw) != 184 or raw[4 + 0x43] != 25:
        raise RuntimeError('GPU调校需要真实UEFI payload180、APVersionCheck=25')


def check_gpu_capability(ec):
    check_machine()
    if os.uname().release != '6.8.0-149-generic' or ec.read(0x7D2) & 31 != 25:
        raise RuntimeError('GPU调校仅支持已验证内核6.8.0-149-generic与GFID=25')
    fd = os.open(GPU_UEFI, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('GPU固件变量权限异常')
        parse_gpu_uefi(os.read(fd, 185))
    finally:
        os.close(fd)


def gpu_round_adapter(ec):
    flags = ec.read(0x7CC)
    return bool(flags & 1 or not flags & 15 and ec.read(0x490) & 1)


def check_gpu_runtime():
    process=subprocess.run(['/usr/bin/systemctl','is-active','--quiet','nvidia-powerd.service'],
                           capture_output=True,text=True,timeout=2)
    if process.returncode:raise RuntimeError('nvidia-powerd未运行，拒绝启用GPU调校')
    process=subprocess.run(['/usr/local/libexec/mechrevo-acpi-check','--summary'],
                           capture_output=True,text=True,timeout=3)
    data=json.loads(process.stdout)
    if process.returncode or not isinstance(data,dict) or data.get('healthy')is not True:
        raise RuntimeError('ACPI完整性检查未通过，拒绝启用GPU调校')


def unmanaged_gpu_clean(ec):
    return all(not ec.read(a)&mask for a,mask in GPU_OWN_MASKS.items())


def state_masks(state):
    result = dict(BASE_OWN_MASKS)
    if 'gpu_ctgp' in state['config']:
        result.update(GPU_OWN_MASKS)
    result.update({a:255 for a in range(0xF00, 0xF60)})
    return result


def owned_group(address):
    if address in (MODE, 0x726, 0x727): return 'mode'
    if address in GPU_OWN_MASKS: return 'gpu'
    if address in (0x783, 0x784): return 'cpu'
    if address == 0x741: return 'appe'
    return 'fan'


def make_table(config):
    return (CPU_UP + CPU_DOWN + [2*v for v in config['cpu_fan']] + [200]*5
            + GPU_UP + GPU_DOWN + [2*v for v in config['gpu_fan']] + [200]*5)


def read_state():
    try:
        fd = os.open(STATE, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o077:
            raise RuntimeError('自定义恢复记录权限异常')
        raw = os.read(fd, 32769)
        if len(raw) > 32768: raise RuntimeError('自定义恢复记录过长')
        data = json.loads(raw)
        if (not isinstance(data,dict) or type(data.get('version')) is not int or data['version'] not in (1,2)
                or data.get('phase') not in ('preparing','active','restoring')):
            raise RuntimeError('自定义恢复记录格式异常')
        validate_config(data['config'])
        if data['version']==1 and ('gpu_ctgp' in data['config'] or data['phase']=='restoring'):
            raise RuntimeError('旧恢复记录不能声明GPU所有权')
        masks = state_masks(data); expected = set(masks)
        for field in ('before','target'):
            data[field] = {int(k):v for k,v in data[field].items()}
            if set(data[field]) != expected or any(type(v) is not int or not 0<=v<=255 for v in data[field].values()):
                raise RuntimeError('自定义恢复记录数据异常')
        if data['version']==2:
            if set(data) != {'version','phase','config','before','target','confirmed','pending','relinquished','legacy_ambiguous'}:
                raise RuntimeError('新恢复记录字段异常')
            data['confirmed']={int(k):v for k,v in data['confirmed'].items()}
            if (set(data['confirmed']) != expected
                    or any(type(v)is not int or v<0 or v & ~masks[a] for a,v in data['confirmed'].items())
                    or type(data['legacy_ambiguous'])is not bool
                    or not isinstance(data['relinquished'],list)
                    or any(g not in ('mode','gpu','cpu','appe','fan')for g in data['relinquished'])):
                raise RuntimeError('新恢复记录所有权异常')
            pending=data['pending']
            if pending is not None and (not isinstance(pending,dict) or set(pending)!={'address','value'}
                    or type(pending['address'])is not int or pending['address']not in masks
                    or type(pending['value'])is not int or pending['value']<0
                    or pending['value'] & ~masks[pending['address']]):
                raise RuntimeError('新恢复记录pending异常')
        return data
    finally:
        os.close(fd)


def save_state(data):
    fd, temp_name = tempfile.mkstemp(prefix='.mechrevo-', dir=STATE.parent)
    temp = Path(temp_name)
    try:
        payload = json.dumps(data).encode()
        with os.fdopen(fd, 'wb') as stream:
            stream.write(payload); stream.flush(); os.fsync(stream.fileno())
        os.replace(temp, STATE)
        directory=os.open(STATE.parent,os.O_RDONLY|os.O_DIRECTORY)
        try:os.fsync(directory)
        finally:os.close(directory)
    finally:
        if temp.exists(): temp.unlink()


def matches(ec, state):
    masks=state_masks(state)
    gpu_context='gpu_ctgp'in state['config'] or unmanaged_gpu_clean(ec)
    return gpu_context and not state.get('relinquished') and not state.get('pending') and all(ec.read(a) & masks[a] == v & masks[a]
               for a,v in state['target'].items())


def accepted_bits(state, address):
    result={state['confirmed'][address]}
    pending=state['pending']
    if pending and pending['address']==address: result.add(pending['value'])
    return result


def check_owned(ec, state, *, allow_mode_handoff):
    """Full fresh check before every write; historical baselines are not ownership."""
    if any(g!='mode' for g in state['relinquished']):
        raise RuntimeError('检测到外来调校接管，保留恢复记录并暂停全部写入')
    lost=set()
    # Even CPU-only tuning uses APPE. Never enable/disable an external GPU
    # request through that shared bit; this is read-only admission, not ownership.
    if 'gpu_ctgp'not in state['config'] and not unmanaged_gpu_clean(ec):lost.add('gpu')
    for a,mask in state_masks(state).items():
        group=owned_group(a)
        if group in state['relinquished']: continue
        if ec.read(a)&mask not in accepted_bits(state,a):lost.add(group)
    # Recheck shared policy/mode context after the longer fan-RAM scan.
    masks=state_masks(state)
    for a in (MODE,0x726,0x727,0x741,*GPU_OWN_MASKS):
        if a in masks and owned_group(a)not in state['relinquished']:
            if ec.read(a)&masks[a]not in accepted_bits(state,a):lost.add(owned_group(a))
    if 'gpu_ctgp'not in state['config'] and not unmanaged_gpu_clean(ec):lost.add('gpu')
    if lost:
        state['relinquished']=sorted(set(state['relinquished'])|lost)
        save_state(state)
    if lost-{'mode'} or ('mode'in state['relinquished'] and not allow_mode_handoff):
        raise RuntimeError('检测到外来控制变化，保留其GPU/APPE/风扇或模式状态')


def migrate_state(ec, state):
    if state['version']==2:return state
    if not unmanaged_gpu_clean(ec):raise RuntimeError('旧恢复记录无法证明外来GPU的APPE上下文，保留记录')
    masks=state_masks(state)
    converted={**state,'version':2,'confirmed':{},'pending':None,'relinquished':[],
               'legacy_ambiguous':state['phase']=='preparing'}
    for a,mask in masks.items():
        value=ec.read(a)&mask
        target=state['target'][a]&mask
        allowed={target}
        if state['phase']=='preparing':allowed.add(state['before'][a]&mask)
        if value not in allowed:
            if owned_group(a)=='mode':converted['relinquished']=['mode']
            else:raise RuntimeError('旧恢复记录发现外来值，拒绝猜测所有权')
        converted['confirmed'][a]=value if state['phase']=='preparing' else target
    save_state(converted)  # One-time migration; reads/status never rewrite v1.
    return converted


def resolve_pending(ec, state):
    if state['pending'] is None:return
    check_owned(ec,state,allow_mode_handoff=True)
    a=state['pending']['address'];mask=state_masks(state)[a]
    value=ec.read(a)&mask
    if owned_group(a) not in state['relinquished'] and value not in accepted_bits(state,a):
        state['relinquished']=sorted(set(state['relinquished'])|{owned_group(a)})
        save_state(state)
        raise RuntimeError('pending恢复时发现外来写入')
    state['confirmed'][a]=value;state['pending']=None;save_state(state)


def tuning_put(ec, state, address, value, *, restoring=False):
    if state['pending'] is not None:raise RuntimeError('存在未确认写入，停止后续调校')
    if restoring and owned_group(address) in state['relinquished']:return
    check_owned(ec,state,allow_mode_handoff=restoring)
    if restoring and owned_group(address) in state['relinquished']:return
    mask=state_masks(state)[address];bits=value&mask
    current=ec.read(address)
    if current&mask != state['confirmed'][address]:
        state['relinquished']=sorted(set(state['relinquished'])|{owned_group(address)})
        save_state(state)
        raise RuntimeError('写入前所有权发生变化')
    if current&mask==bits:return
    state['pending']={'address':address,'value':bits};save_state(state)
    # fsync may take time. Recheck ownership afterward and merge the newest
    # unowned bits; pending is crash recovery evidence, not permission to accept
    # an external write of our intended target before we have written anything.
    check_owned(ec,state,allow_mode_handoff=restoring)
    if restoring and owned_group(address)in state['relinquished']:
        state['pending']=None;save_state(state);return
    current=ec.read(address)
    if current&mask!=state['confirmed'][address]:
        state['relinquished']=sorted(set(state['relinquished'])|{owned_group(address)})
        save_state(state)
        raise RuntimeError('恢复记录保存期间发生外来写入')
    ec.write_tuning(address,(current&~mask)|bits)
    if ec.read(address)&mask!=bits:raise RuntimeError('自定义写入回读不一致')
    state['confirmed'][address]=bits;state['pending']=None;save_state(state)


def restore_tuning(ec):
    state=read_state()
    if not state:return
    state=migrate_state(ec,state)
    resolve_pending(ec,state)
    state['phase']='restoring';save_state(state)
    check_owned(ec,state,allow_mode_handoff=True)
    before=state['before']
    def put(a,value):tuning_put(ec,state,a,value,restoring=True)
    # Remove custom GPU execution before targets, APPE or custom-mode context.
    if 'gpu_ctgp'in state['config']:
        for a in (0x743,0x745,0x746,0x744):put(a,before[a])
    for a in (0x783,0x784):put(a,before[a])
    put(0x7C6,0)
    for a in range(0xF00,0xF60):put(a,before[a])
    put(0x7C5,before[0x7C5]);put(0x7C6,before[0x7C6])
    put(0x741,before[0x741])
    for a in (0x726,0x727,MODE):put(a,before[a])
    check_owned(ec,state,allow_mode_handoff=True)
    STATE.unlink()


def apply_tuning(ec, config, pause=time.sleep):
    validate_config(config)  # Reject before undoing an existing profile.
    if 'gpu_ctgp'in config:
        check_gpu_capability(ec)
        check_gpu_runtime()
        if not gpu_round_adapter(ec):raise RuntimeError('GPU调校需要圆口电源')
    restore_tuning(ec)
    initial = snapshot(ec)
    if not standard_state(initial): raise RuntimeError('当前控制状态不允许接管自定义设置')
    masks=state_masks({'config':config});addresses=list(masks)
    if not unmanaged_gpu_clean(ec):
        raise RuntimeError('已有外来自定义GPU请求，拒绝接管')
    before = {a:ec.read(a) for a in addresses}
    target = dict(before)
    for a,mask in ((0x726,128),(0x727,64),(0x741,1),(0x7C5,128),(0x7C6,4)):
        target[a] |= mask
    target[MODE] = 0
    target[0x783], target[0x784] = config['pl1'], config['pl2']
    if 'gpu_ctgp'in config:
        boost=config.get('gpu_db',0)
        target.update({0x743:(before[0x743]&~7)|(7 if boost else 5),0x744:config['gpu_ctgp']-65,
                       0x745:255 if boost else 0,0x746:boost})
    target.update({0xF00+i:v for i,v in enumerate(make_table(config))})
    if snapshot(ec) != initial or any(ec.read(a)!=v for a,v in before.items()):
        raise RuntimeError('硬件状态变化，请重试')
    state = {'version':2,'phase':'preparing','before':before,'target':target,'config':config,
             'confirmed':{a:v&masks[a]for a,v in before.items()},'pending':None,
             'relinquished':[],'legacy_ambiguous':False}
    save_state(state)  # Persist recovery information before the first write.
    try:
        def put(a,value):
            if 'gpu_ctgp'in config and not gpu_round_adapter(ec):raise RuntimeError('圆口电源失去，撤销GPU调校')
            tuning_put(ec,state,a,value)
        for a in (0x727,MODE,0x726):put(a,target[a])
        for a in (0x741,0x783,0x784,0x7C5):
            put(a,target[a])
        if 'gpu_ctgp'in config:
            for a in (0x744,0x745,0x746,0x743):put(a,target[a])
        for a in range(0xF00,0xF60):put(a,target[a])
        put(0x7C6,target[0x7C6])
        pause(0.25)
        if 'gpu_ctgp'in config and not gpu_round_adapter(ec):raise RuntimeError('圆口电源失去，撤销GPU调校')
        if not matches(ec,state): raise RuntimeError('自定义设置回读不一致')
        state['phase']='active'; save_state(state)
        return status(ec)
    except BaseException as error:
        try: restore_tuning(ec)
        except Exception as recovery:
            raise RuntimeError(str(error)+'；恢复尚未完成：'+str(recovery)) from error
        raise


def acquire_profile_lock(fd, *, background=False):
    deadline=time.monotonic()+1.5
    while True:
        try:
            fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
            return
        except BlockingIOError as error:
            if background:raise  # Guard yields immediately to foreground work.
            remaining=deadline-time.monotonic()
            if remaining<=0:
                raise BlockingIOError(errno.EAGAIN,'性能控制忙：等待1.5秒后仍未取得锁，请稍后重试') from error
            time.sleep(min(0.02,remaining))


def main(args):
    valid = args in (['status'],['reset'],['reconcile'],['logo-status'],['turbo-status']) or (len(args)==2 and
            ((args[0]=='set' and args[1] in MODES) or args[0] in ('apply','logo') or
             (args[0]=='turbo' and args[1] in ('quiet','extreme','off'))))
    if not valid: raise ValueError('用法：status | set office|balanced|turbo|custom | apply JSON | reset | logo-status | logo on|off|JSON | turbo-status | turbo quiet|extreme|off')
    config = validate_config(json.loads(args[1])) if args[0]=='apply' and len(args[1])<4096 else None
    logo_config = None
    if args[0]=='logo':
        if len(args[1])>1024: raise ValueError('Logo 设置过长')
        if args[1] not in ('on','off'):logo_config=validate_logo(json.loads(args[1]))
    if args[0]=='apply':
        if config is None: raise ValueError('设置过长')
        result = subprocess.run(['/usr/bin/systemctl','is-active','--quiet','mechrevo-profile-guard.service'])
        if result.returncode: raise RuntimeError('恢复守护服务未运行，拒绝应用自定义设置')
    if args == ['reconcile'] and not STATE.exists(): return {'idle': True}
    check_machine()
    if args[0]=='turbo-status': return turbo_request(['status'], optional=True)
    if args[0]=='turbo':
        turbo_request(['release'] if args[1]=='off' else ['select',args[1]])
        return main(['status'])
    if args[0] in ('set','apply','reset'):
        released = turbo_request(['release'], optional=True)
        if released.get('active') or released.get('recovery_needed'):
            raise RuntimeError('狂暴调度尚未释放，拒绝切换或调校')
    turbo = (turbo_request(['status'], optional=True) if args[0]=='status' else
             released if args[0] in ('set','apply','reset') else None)
    fd = os.open('/run/mechrevo-profile.lock', os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('性能控制锁文件权限异常')
        acquire_profile_lock(fd,background=args[0]=='reconcile')
        ec = EC(writable=args[0] not in ('status','logo-status'))
        try:
            if args[0]=='logo-status': return logo_status(ec)
            if args[0]=='logo':
                if logo_config is None:
                    current=logo_status(ec)
                    logo_config={k:current[k] for k in ('mode','brightness','color')}
                    logo_config['brightness']=(current['brightness'] or 25) if args[1]=='on' else 0
                    if args[1]=='on' and not any(logo_config['color']):logo_config['color']=[255,255,255]
                return set_logo(ec,logo_config)
            if args[0]=='apply':
                apply_tuning(ec,config)
                return status_with_turbo(ec,turbo)
            if args[0] in ('set','reset'): restore_tuning(ec)
            if args[0]=='set':
                set_mode(ec,args[1])
                return status_with_turbo(ec,turbo)
            if args[0]=='reconcile':
                state=read_state()
                if state and (state['phase']!='active' or not matches(ec,state)
                              or 'gpu_ctgp'in state['config'] and not gpu_round_adapter(ec)):
                    restore_tuning(ec)
            return status_with_turbo(ec, turbo) if turbo is not None else status(ec)
        finally: ec.close()
    finally: os.close(fd)


def guard():
    last_error = 0
    while True:
        try: main(['reconcile'])
        except BlockingIOError: pass  # Another helper transaction owns the lock.
        except Exception as exc:
            if time.monotonic()-last_error>30:
                print(str(exc),file=sys.stderr,flush=True); last_error=time.monotonic()
        time.sleep(1)


if __name__ == '__main__':
    try:
        if sys.argv[1:]==['guard']: guard()
        else: print(json.dumps(main(sys.argv[1:]), ensure_ascii=False))
    except Exception as exc:
        print(json.dumps({'error': str(exc)}, ensure_ascii=False))
        sys.exit(1)
