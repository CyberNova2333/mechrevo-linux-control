[Unit]
Description=Pause Dynamic Boost for sleep and validate ACPI before restoring it
Before=sleep.target nvidia-suspend.service nvidia-hibernate.service
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/mechrevo-powerd-sleep pre
ExecStop=/usr/local/libexec/mechrevo-powerd-sleep post
TimeoutStartSec=45
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=sleep.target
