+        policy.tick()
+        return True
+
+    def manager_signal(_connection, _sender, _path, _interface, member, params, _data):
+        values = params.unpack()
+        if member == "PrepareForSleep":
+            lifecycle.prepare_for_sleep(values[0])
+        elif member == "PrepareForShutdown" and values[0]:
