+def profiles_path() -> Path:
+    """Return the user's Track 3 profile configuration path."""
+    base = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
+    return base / "iteglow" / "profiles.json"
+
