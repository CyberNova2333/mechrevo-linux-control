+    hotkey_timer = GLib.timeout_add_seconds(1, hotkey_tick)
+    try:
+        loop.run()
+    finally:
+        lifecycle.stop()
+        policy.deactivate()
+        rule_runner.deactivate()
+        GLib.source_remove(hotkey_timer)
+        GLib.source_remove(policy_timer)
+        system_bus.signal_unsubscribe(subscription)
+        if lock_fd is not None:
+            os.close(lock_fd)
