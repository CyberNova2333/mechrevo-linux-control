+
+    def stop():
+        lifecycle.stop()
+        policy.deactivate()
+        rule_runner.deactivate()
+        loop.quit()
+        return False
+
+    subscription = system_bus.signal_subscribe(
+        "org.freedesktop.login1", "org.freedesktop.login1.Manager", None,
+        "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, manager_signal, None)
