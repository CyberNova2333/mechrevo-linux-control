+def _rgba(rgb: List[int]) -> Gdk.RGBA:
+    c = Gdk.RGBA()
+    r, g, b = rgb
+    c.red, c.green, c.blue, c.alpha = r / 255.0, g / 255.0, b / 255.0, 1.0
+    return c
