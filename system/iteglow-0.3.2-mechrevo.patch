+def _save_local_wc_patch(patch: dict) -> dict:
+    cur = wc.load_config()
+    merged = dict(cur)
+    for k, v in patch.items():
+        if k in ("manual", "curve", "led") and isinstance(v, dict) and isinstance(merged.get(k), dict):
+            sub = dict(merged[k])
+            sub.update(v)
+            merged[k] = sub
+        else:
+            merged[k] = v
+    return wc.save_config(merged)
+
+
