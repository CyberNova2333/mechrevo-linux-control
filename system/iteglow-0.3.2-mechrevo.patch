+def default_config() -> dict:
+    """Return the default opt-out configuration with auto-switching disabled."""
+    return {
+        "version": 1,
+        "auto_switch_enabled": False,
+        "restore_previous": True,
+        "cooldown_seconds": 5,
+        "profiles": {},
+        "rules": [],
+    }
