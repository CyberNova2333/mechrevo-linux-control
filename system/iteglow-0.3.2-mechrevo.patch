+.mechrevo-shell { background: #f4f6fa; color: #1d2940; font-size: 13px; }
+.mechrevo-shell .sidebar { background: #eaf0f7; padding: 28px 16px 20px; border-right: 1px solid #dfe6f0; }
+.mechrevo-shell .brand-mark { font-size: 28px; font-weight: 900; letter-spacing: 3px; color: #2f63db; margin-bottom: 6px; }
+.mechrevo-shell .brand-title { font-size: 20px; font-weight: 700; letter-spacing: 2px; }
+.mechrevo-shell .subtitle { color: #66758a; font-size: 12px; }
+.mechrevo-shell .small-note { color: #718096; font-size: 11px; }
+.mechrevo-shell .nav-section { color: #7b879b; font-size: 11px; margin: 32px 10px 8px; }
+.mechrevo-shell button { background: #fff; background-image: none; color: #34435a; border: 1px solid #dbe3ee; border-radius: 9px; box-shadow: none; text-shadow: none; padding: 8px 12px; min-height: 20px; font-weight: 500; }
+.mechrevo-shell button:hover { background: #f0f5ff; border-color: #afc6ef; }
+.mechrevo-shell button:focus-visible { outline: 2px solid #719cf0; outline-offset: 2px; }
+.mechrevo-shell button.selected { background: #eaf2ff; color: #2459c4; border-color: #81a8f2; }
+.mechrevo-shell button:disabled { opacity: .55; }
+.mechrevo-shell .nav-button { background: transparent; border: 1px solid transparent; padding: 13px 12px; font-weight: 600; }
+.mechrevo-shell .nav-button.selected { background: #fff; border-color: #d9e5fa; color: #275dc6; box-shadow: 0 3px 8px alpha(#315b9c,.06); }
+.mechrevo-shell .device-name { font-size: 12px; font-weight: 600; color: #4c5e77; }
+.mechrevo-shell .topbar { background: #fff; padding: 14px 24px; border-bottom: 1px solid #e4eaf2; }
+.mechrevo-shell .topbar-label { color: #8290a5; font-size: 12px; }
+.mechrevo-shell .all-off { font-size: 12px; }
+.mechrevo-shell .device-page, .mechrevo-shell .performance-page { padding: 22px 24px; }
+.mechrevo-shell .page-title { font-size: 24px; font-weight: 750; color: #1d2c44; }
+.mechrevo-shell .connection-pill { color: #20815d; background: #e8f5ef; border-radius: 20px; padding: 7px 12px; font-size: 11px; }
+.mechrevo-shell .control-card { background: #fff; border: 1px solid #e1e7f0; border-radius: 14px; padding: 16px; }
+.mechrevo-shell .section-title { font-size: 14px; font-weight: 700; color: #24344e; }
+.mechrevo-shell .effect-tile { min-height: 35px; padding: 7px 8px; font-size: 12px; font-weight: 600; }
+.mechrevo-shell .value-label { font-size: 11px; color: #5874a1; }
+.mechrevo-shell .status-text { font-size: 11px; color: #526f93; min-height: 16px; }
+.mechrevo-shell .small-button { padding: 2px 8px; font-size: 10px; min-height: 16px; }
+.mechrevo-shell .color-swatch { padding: 3px; min-width: 24px; min-height: 23px; border-radius: 7px; }
+.mechrevo-shell colorswatch { border-radius: 5px; }
+.mechrevo-shell scale { padding: 10px 0; }
+.mechrevo-shell scale trough { background: #e7edf6; min-height: 5px; border: none; border-radius: 8px; }
+.mechrevo-shell scale highlight { background: #477ce5; border: none; border-radius: 8px; }
+.mechrevo-shell scale slider { background: #fff; border: 2px solid #477ce5; box-shadow: 0 1px 3px alpha(#1b3f80,.15); min-width: 12px; min-height: 12px; margin: -6px 0; }
+.mechrevo-shell dropdown button { padding: 5px 8px; font-size: 11px; }
+.mechrevo-shell .mode-card { min-height: 90px; padding: 18px 12px; }
+.mechrevo-shell .mode-name { font-size: 17px; font-weight: 700; }
+.mechrevo-shell .mode-led { font-size: 12px; }
+.mechrevo-shell .green-led { color: #20966c; }
+.mechrevo-shell .blue-led { color: #4074df; }
+.mechrevo-shell .purple-led { color: #9660db; }
+.mechrevo-shell .performance-current { background: #142238; color: #edf4ff; border-radius: 15px; padding: 26px; font-size: 21px; font-weight: 700; }
+
+.mechrevo-shell .page-scroll > viewport { background: #f4f6fa; }
+.mechrevo-shell scale highlight { min-width: 1px; min-height: 5px; padding: 0; margin: 0; }
+.mechrevo-shell scale trough { padding: 0; margin: 0; }
+.mechrevo-shell .mode-card.selected:disabled { opacity: 1; color: #2459c4; background: #eaf2ff; border-color: #81a8f2; }
+
+.mechrevo-shell scale:disabled { opacity: .4; }
