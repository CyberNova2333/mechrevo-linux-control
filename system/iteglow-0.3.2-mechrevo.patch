+            self.release_zone();self.release_hold();return False
+        try:
+            if not self.zone.acquire(blocking=False):
+                if time.monotonic()-self.zone_started<5:return True
+                raise TimeoutError('Logo 灯光操作仍忙，请稍后重试')
+        except Exception as exc:
