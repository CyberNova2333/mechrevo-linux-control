+def rounded(cr, x, y, w, h, radius):
+    cr.new_sub_path()
+    for cx, cy, start in [(x+w-radius,y+radius,-math.pi/2), (x+w-radius,y+h-radius,0),
+                          (x+radius,y+h-radius,math.pi/2), (x+radius,y+radius,math.pi)]:
+        cr.arc(cx, cy, radius, start, start+math.pi/2)
+    cr.close_path()
