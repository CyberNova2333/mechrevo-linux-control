#!/usr/bin/python3 -I
"""Fixed qualified module prepare/sleep protocol; no policy selection command."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from mechrevo_turbo_lifecycle import main

parser = argparse.ArgumentParser(description="性能驱动受控加载和睡眠清理")
parser.add_argument("phase", choices=("prepare", "pre", "post"))
args = parser.parse_args()
try:
    print(json.dumps({"ok": True, "result": main(args.phase)}, ensure_ascii=False))
except Exception as error:
    print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False))
    sys.exit(1)
