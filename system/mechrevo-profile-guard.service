[Unit]
Description=Recover managed MECHREVO tuning after mode-key changes or interrupted writes
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/mechrevo-profile-helper guard
ExecStopPost=/usr/local/libexec/mechrevo-profile-helper reset
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
