[Unit]
Description=Exact-model MECHREVO turbo workload lease supervisor (Rust)
After=local-fs.target mechrevo-acpi-baseline.service nvidia-powerd.service mechrevo-profile-guard.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
ExecCondition=/usr/bin/systemctl is-active --quiet nvidia-powerd.service
ExecStartPre=/usr/local/libexec/mechrevo-turbo-lifecycle prepare
ExecStart=/usr/local/libexec/mechrevo-turbod
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
TimeoutStartSec=20
MemoryLow=8M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run
RestrictAddressFamilies=AF_UNIX

# Starting the qualified service never selects a performance policy.
[Install]
WantedBy=multi-user.target
Also=mechrevo-turbo-sleep.service
